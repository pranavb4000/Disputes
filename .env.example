# =====================================================================================
# Dispute Management System - environment configuration (TECH_STACK.md §18)
# Copy to .env with:  python tools/init_env.py   (fills every __GENERATE__ with a random secret)
# NEVER commit .env. This example contains placeholders only.
# Used by docker compose AND by the backend when run natively (backend reads ../.env).
# =====================================================================================

APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# --- Container images (point these at the bank's Artifactory registry) -----------------
# e.g. ORACLE_IMAGE=artifactory.bank.internal/docker-remote/gvenzl/oracle-xe:21-slim
ORACLE_IMAGE=gvenzl/oracle-xe:21-slim
REDIS_IMAGE=redis:7-alpine
PYTHON_IMAGE=python:3.12-slim
NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
# pip index used while building the backend image, e.g.
# PIP_INDEX_URL=https://artifactory.bank.internal/artifactory/api/pypi/pypi-remote/simple
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# --- Host ports ----------------------------------------------------------------------------
WEB_HOST_PORT=8080
API_HOST_PORT=8000
ORACLE_HOST_PORT=1521
REDIS_HOST_PORT=6379

# --- Oracle ----------------------------------------------------------------------------------
ORACLE_PASSWORD=__GENERATE__
DATABASE_HOST=localhost
DATABASE_PORT=1521
DATABASE_SERVICE=XEPDB1
DATABASE_USER=dms_app
DATABASE_PASSWORD=__GENERATE__

# --- Redis -----------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__

# --- Security ----------------------------------------------------------------------------------
# HS512 signing secret (>= 64 bytes) and AES-256-GCM / blind-index keys (32 bytes, base64).
JWT_SECRET=__GENERATE__
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_IDLE_MINUTES=30
REFRESH_TOKEN_ABSOLUTE_HOURS=10
AES_ENCRYPTION_KEY=__GENERATE__
AES_KEY_VERSION=1
BLIND_INDEX_KEY=__GENERATE__
# Local stack runs on plain http://localhost, so the refresh cookie cannot be Secure here.
COOKIE_SECURE=false

# Where the browser loads the app from (used for the CSRF Origin check).
PUBLIC_ORIGIN=http://localhost:8080
# Extra origins for `flutter run` during development (comma separated), e.g. http://localhost:5000
CORS_ORIGINS=http://localhost:5000

# --- Authentication ------------------------------------------------------------------------------
# local = DEVELOPMENT-ONLY accounts (refused in staging/production). Phase 2: ldap
AUTH_PROVIDER=local
DEV_USER_PASSWORD=__GENERATE__
DEV_CHECKER_PASSWORD=__GENERATE__

# LDAP (Phase 2) - leave empty for now
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_FILTER=(sAMAccountName={username})

# --- File storage ----------------------------------------------------------------------------------
# local (dev folder) or s3 (AWS; credentials come from the ECS task role, never from this file)
STORAGE_BACKEND=local
S3_BUCKET=
S3_KMS_KEY_ID=
AWS_REGION=ap-south-1
